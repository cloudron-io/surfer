    "async": "^3.2.6",
    "commander": "^15.0.0",
    "content-disposition": "^3.0.0",
    "ejs": "^6.0.1",
    "multiparty": "^4.3.1",
    "@cloudron/superagent": "^2.3.0",
    "webdav-server": "^2.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "filesize": "^11.0.23",
    "globals": "^17.12.0",
    "mocha": "^12.0.1",
    "vite": "^8.3.0",
    "vue": "^3.5.42"
