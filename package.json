  "description": "Simple file server cli",
  "type": "module",
  "author": {
    "name": "Johannes Zellner",
    "email": "johannes@nebulon.de"
  },
  "scripts": {
    "test": "./node_modules/mocha/bin/_mocha --bail -R spec ./test/test.js",
    "dev": "cd frontend && ../node_modules/.bin/vite",
